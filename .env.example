# Copy to .env and fill in real values. NEVER commit .env.

# MongoDB connection string (MongoDB Atlas or local).
MONGO_URI=mongodb://127.0.0.1:27017/medicore_hms

# Token signing key. Must be long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Comma-separated list of allowed browser origins (the deployed frontend URL).
# Leave unset only for local development.
CORS_ORIGINS=http://localhost:5173

# Super admin, seeded on startup.
SUPERADMIN_NAME=Super Administrator
SUPERADMIN_USERNAME=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# Set to "true" for ONE boot to force the super admin password to be reset from
# SUPERADMIN_PASSWORD above (use to recover from a leaked password), then remove.
SUPERADMIN_RESET_PASSWORD=false
